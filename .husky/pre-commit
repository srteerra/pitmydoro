echo '🏗️ Preparing your code for commit...'
echo ''

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Auto-format code
echo '📝 Running auto-format...'
bun format
echo '✅ Format complete!'
echo ''

# Check Prettier standards
echo '🎨 Checking code formatting...'
bun format:check ||
(
    echo ''
    echo '❌ Formatting check failed!'
    echo '📝 Please run "bun format" to fix styling issues, then try again.'
    echo ''
    exit 1
)
echo '✅ Formatting check passed!'
echo ''

# Check ESLint Standards
echo '🔍 Running linter...'
bun lint ||
(
    echo ''
    echo '❌ Linting check failed!'
    echo '🔧 Please fix the issues listed above and try committing again.'
    echo ''
    exit 1
)
echo '✅ Linting passed!'
echo ''

# If everything passes... Now we can commit
echo '✨ All checks passed! Committing your changes... ✨'
echo ''
